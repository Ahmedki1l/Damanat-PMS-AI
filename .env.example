# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mssql://damanat:damanat@localhost:1433
DB_NAME=damanat_pms
# Max ms a statement may wait on a lock before erroring (SQL Server 1222).
# Bounded so a lock wait can never freeze the event loop (pyodbc is synchronous).
DB_LOCK_TIMEOUT_MS=15000
# ── Network ─────────────────────────────────────────────────────────────────
BACKEND_IP=192.168.1.50
BACKEND_PORT=8080

# ── Security ────────────────────────────────────────────────────────────────
# Set a strong random string to protect API endpoints (cameras are excluded)
# Leave empty to disable API auth during development
API_KEY=

# Camera webhook transport controls. The body cap is enforced while streaming,
# including when Content-Length is omitted. Empty source CIDRs are allowed only
# in off/shadow for compatibility; authoritative mode refuses startup without
# explicit direct-camera or trusted-proxy peer networks.
CAMERA_EVENT_MAX_BODY_BYTES=16777216
# Example only: use the effective peers observed by PMS-AI (camera, proxy, or
# event gateway), preferably exact /32 values. Never copy a site subnet blindly.
# CAMERA_EVENT_ALLOWED_SOURCE_CIDRS=<verified-peer-1>/32,<verified-peer-2>/32
CAMERA_EVENT_ALLOWED_SOURCE_CIDRS=

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Phase 1 Cameras (B1-PARKING) ────────────────────────────────────────────
CAM_04_IP=10.1.13.63
CAM_04_USER=admin
CAM_04_PASSWORD=change-me
CAM_04_NAME=B1-PARKING

CAM_05_IP=10.1.13.64
CAM_05_USER=admin
CAM_05_PASSWORD=change-me
CAM_05_NAME=B1-PARKING

CAM_06_IP=10.1.13.65
CAM_06_USER=admin
CAM_06_PASSWORD=change-me
CAM_06_NAME=B1-PARKING

CAM_07_IP=10.1.13.66
CAM_07_USER=admin
CAM_07_PASSWORD=change-me
CAM_07_NAME=B1-PARKING

# ── Phase 1 Cameras (B2-PARKING) ────────────────────────────────────────────
CAM_09_IP=10.1.13.68
CAM_09_USER=admin
CAM_09_PASSWORD=change-me
CAM_09_NAME=B2-PARKING

CAM_11_IP=10.1.13.70
CAM_11_USER=admin
CAM_11_PASSWORD=change-me
CAM_11_NAME=B2-PARKING

CAM_12_IP=10.1.13.71
CAM_12_USER=admin
CAM_12_PASSWORD=change-me
CAM_12_NAME=B2-PARKING

CAM_13_IP=10.1.13.72
CAM_13_USER=admin
CAM_13_PASSWORD=change-me
CAM_13_NAME=B2-PARKING

CAM_14_IP=10.1.13.73
CAM_14_USER=admin
CAM_14_PASSWORD=change-me
CAM_14_NAME=B2-PARKING

# ── Phase 1 Cameras (other) ─────────────────────────────────────────────────
CAM_02_IP=10.1.13.20
CAM_02_USER=admin
CAM_02_PASSWORD=change-me
CAM_02_NAME=GF-WAITING

CAM_35_IP=10.1.13.54
CAM_35_USER=admin
CAM_35_PASSWORD=change-me
CAM_35_NAME=B1-DATA CENTER

# ── Zone Configuration ──────────────────────────────────────────────────────
# Comma-separated zone IDs for each use case
RESTRICTED_ZONES=restricted-vip,no-parking-zone,emergency-exit,loading-bay
MONITORED_INTRUSION_ZONES=emergency-exit,staff-only-area,after-hours-zone
ALWAYS_VIOLATION_EVENTS=linedetection
VIOLATION_COOLDOWN_SECONDS=30
INTRUSION_COOLDOWN_SECONDS=30
OCCUPANCY_ALERT_THRESHOLD=0.90

# Alert types kept OUT of the real-time SSE stream. Notification-only: these
# alerts are still written to the DB, still logged, and still returned by
# GET /api/v1/alerts — they just stop popping on the dashboard.
# Empty value = notify on every alert type.
SUPPRESSED_ALERT_NOTIFICATION_TYPES=silent_entry

# ── Facility timezone (must match the Gateway) ──────────────────────────────
# Offset from UTC for "today" / "since-local-midnight" math. The Gateway also
# reads this; both services must use the SAME value or per-service "today"
# windows disagree.
#   Saudi Arabia / Riyadh:        3.0  (no DST)
#   Egypt:                        2.0  (note: DST changes seasonally)
#   Cameras report local time
#   without a Z suffix:           use the facility's real UTC offset
#
# Verify: capture one Hikvision webhook payload and inspect <dateTime>. If it
# ends in `Z`, set the facility offset normally. If it has no TZ suffix, PMS-AI
# explicitly interprets it in this configured facility timezone and records that
# provenance for Entry V2.
FACILITY_TIMEZONE_OFFSET_HOURS=3.0

# ── Anti-bounce on entry events (UC1) ───────────────────────────────────────
# Suppress an entry-camera ANPR firing if the same plate had an exit within
# this many seconds — handles the case where the entry camera captures a car
# driving away from the exit gate. Default 30s. Set to 0 to disable
# suppression entirely (use with care; will produce duplicate entry rows
# whenever the entry camera over-triggers near the exit lane).
ENTRY_ANTIBOUNCE_SECONDS=30

# ── ANPR entry burst aggregation (UC1) ──────────────────────────────────────
# The entry ANPR camera fires several reads per car as it approaches; the early
# read is often wrong, a later read is correct. The backend buffers the burst
# and writes ONE entry labeled by the LAST read, after a short debounce window.
# ANPR_BURST_WINDOW_SECONDS: idle gap after the final read before flushing.
# ENTRY_PENDING_CROSSING_SECONDS: maximum CAM-23-crossing→ANPR webhook lag.
# ANPR_BURST_MAX_SECONDS: hard cap on a buffer's lifetime (ghost backstop).
ANPR_BURST_WINDOW_SECONDS=2.5
# Separate from the debounce above. The 10-second default tolerates several
# seconds of delivery jitter without opening an overly broad anonymous FIFO.
ENTRY_PENDING_CROSSING_SECONDS=10.0
# MAX must exceed the real CAM-ENTRY-read→CAM-23-crossing travel time (~8s here),
# or valid entries drop just before the ramp crossing confirms them.
ANPR_BURST_MAX_SECONDS=20.0
# Ramp line-crossing cameras that confirm "one car physically entered" (entry
# confirmation + per-car burst boundary + silent-entry detection). CAM-23 is the
# new entry-ramp cam (no ANPR); CAM-03 is the in-garage backstop.
ENTRY_CONFIRM_CAMERAS=CAM-23,CAM-03
# CAM-23 line id + direction that mean "into the garage" (read off real CAM-23
# linedetection events, like OCCUPANCY_ENTRANCE_ZONES). When CAM-23 is enabled,
# authoritative V2 requires at least one value; both may be empty only in
# off/shadow while collecting calibration payloads. If both are set, both must
# match. Prefer setting both when the camera reports a stable direction.
CAM23_ENTRY_LINE=
CAM23_ENTRY_DIRECTION=
# PMS `direction` marker per confirmation camera, so the PMS can tell the
# ramp-top (CAM-23) and in-garage (CAM-03) images apart. "source:direction"
# pairs; unlisted sources fall back to "B-entry".
ENTRY_CONFIRM_DIRECTIONS=CAM-23:ramp-entry,CAM-03:B-entry
# How long (seconds) after an entry is written a late CAM-03 crossing may still
# attach its in-garage image to that entry.
ENTRY_CONFIRM_MATCH_SECONDS=30.0

# ── HikCentral plate validation / recovery ──────────────────────────────────
# HikCentral is NOT the normal plate source — the ANPR camera already reports
# the plate. HikCentral only (1) validates that reported plate and (2) recovers
# a plate when the camera reported none (~22% of cars, today lost entirely as
# `silent_entry` alerts with no session).
#
#   off           = never contacted; behaviour identical to before this layer.
#   shadow        = looked up and logged, but the ANPR plate always wins and no
#                   recovery session is created. Changes NO behaviour — it only
#                   records what `authoritative` WOULD have done, so mismatch
#                   and recovery rates can be measured first. Start here.
#   authoritative = a disagreeing HikCentral plate replaces the ANPR plate, and
#                   a unique HikCentral record recovers a missing plate.
# A misconfigured layer force-disables ITSELF (logged at ERROR) rather than
# stopping the app — nothing in the pipeline depends on HikCentral. Remember
# the deployed config is NOT this file; set these wherever the pod's env comes
# from, or the mode you set here is not the mode that runs.
HIK_VALIDATION_MODE=off
# Required whenever the mode is not "off". Credential-free base URL, and the
# SCHEME IS MANDATORY: a bare "10.1.20.51" is rejected (it once crash-looped
# every worker in production before the fallback above existed).
HIK_BASE_URL=https://10.1.20.51
# Artemis OpenAPI AppKey/AppSecret from a HikCentral Integration Partner
# (System Configuration -> Third-Party Integration -> OpenAPI Gateway -> Add).
# Authorize the partner for the ANPR APIs (Search for vehicle records + Get
# vehicle picture). Every request is HmacSHA256-signed with these; there is no
# login, session, or cookie. HIK_APP_SECRET is a credential — env only.
HIK_APP_KEY=
HIK_APP_SECRET=
# The on-site platform serves a self-signed certificate.
HIK_VERIFY_TLS=false
# OpenAPI camera indexCode for the entry LPR camera (one code). Discover via
# POST /artemis/api/resource/v1/cameras. Confirmed on this site: 447 = "ANPR-1
# Entry" (exit "ANPR-2 Exit" = 453).
HIK_ENTRY_RESOURCE_IDS=447
# Lookup window around the anchor event (the ANPR read when validating, the
# ramp crossing when recovering). Deliberately tiny — HikCentral is asked about
# ONE car, never for history.
HIK_QUERY_LOOKBACK_SECONDS=30.0
HIK_QUERY_LOOKAHEAD_SECONDS=5.0
# Results come back newest-first (orderType=1); leave room for cars that passed
# just after the anchor.
HIK_QUERY_PAGE_SIZE=10
# The OpenAPI honours the sent timezone exactly — no shift compensation needed
# (unlike the old web VehicleLogs). Kept at 0; unused by the client.
HIK_QUERY_TIME_SHIFT_HOURS=0.0
# A HikCentral record may only be paired with a gate event this far away.
HIK_MATCH_MAX_SKEW_SECONDS=10.0
HIK_CONNECT_TIMEOUT_SECONDS=3.0
HIK_READ_TIMEOUT_SECONDS=5.0
HIK_IMAGE_MAX_BYTES=8388608

# ── Snapshot fetch auth fallback ────────────────────────────────────────────
# Default empty = Digest only. Set to "basic" to fall back to Basic auth on
# 401/403 from Digest. Useful for diagnosing camera firmwares that reject
# Digest.
SNAPSHOT_AUTH_FALLBACK=

# ── Phase 2 Cameras (ANPR — entry/exit gates) ───────────────────────────────
CAM_ENTRY_IP=10.1.13.100
CAM_ENTRY_USER=admin
CAM_ENTRY_PASSWORD=change-me
CAM_ENTRY_NAME=ENTRY-GATE

CAM_EXIT_IP=10.1.13.101
CAM_EXIT_USER=admin
CAM_EXIT_PASSWORD=change-me
CAM_EXIT_NAME=EXIT-GATE

# ── Node.js Core Backend Integration (parking-times forwarding to MongoDB) ───
# Leave NODEBACK_URL empty to disable ANPR forwarding
NODEBACK_URL=http://localhost:3000
NODEBACK_SITE_ID=<uuid-of-this-site>
NODEBACK_SERVICE_KEY=damanat-internal-service-key-2026

# ── PMS Tracking API (plate forwarding) ──────────────────────────────────
# Peer VA origin. Use a plain URL, never Markdown link syntax.
PMS_API_URL=http://pms-video-analytics:8000

# Reliability for the forward above: on a transient failure the undelivered
# payload is spooled to disk and re-POSTed from a background task (every
# DRAIN_INTERVAL) until VA acks, so an image is not lost when VA is briefly
# unreachable. Legacy/non-exit payloads older than SPOOL_MAX_AGE are dropped.
# Active-V2 exits are metadata-only and never age out; their exact source time
# makes delayed replay safe and prevents stale VA identity after long outages.
# Exit delivery requires VA's semantic 2xx acknowledgement, not status alone.
# Writes are file+directory fsynced; malformed records move to `.corrupt` files,
# and transient read errors retain the original. Legacy entry files remain
# quarantined for audit while V2 is authoritative.
PMS_FORWARD_SPOOL_DIR=./pms_forward_spool
PMS_FORWARD_DRAIN_INTERVAL_SECONDS=15.0
PMS_FORWARD_SPOOL_MAX_AGE_SECONDS=3600.0

# Entry validation V2. Keep off until VA has both multipart ingest endpoints
# and its authenticated confirmation callback configured. Shadow/authoritative
# fail startup unless PMS_API_URL is a plain absolute HTTP(S) peer URL and the
# service key plus all timeout/image bounds below are valid.
ENTRY_V2_MODE=off
ENTRY_V2_SERVICE_KEY=
# Exact source aliases used only when normal camera resolution has no gate.
# Alias only a unique, immutable, entry-only identity such as device_serial.
# Never map a shared proxy/NAT UNKNOWN-<peer-ip> identity to CAM-ENTRY: that peer
# may also carry exits or other cameras.
# ENTRY_V2_CAMERA_ALIASES=<verified-entry-device-serial>=CAM-ENTRY
ENTRY_V2_CAMERA_ALIASES=
ENTRY_V2_CONNECT_TIMEOUT_SECONDS=2.0
ENTRY_V2_READ_TIMEOUT_SECONDS=30.0
ENTRY_V2_WRITE_TIMEOUT_SECONDS=10.0
ENTRY_V2_POOL_TIMEOUT_SECONDS=2.0
# Maximum image-bearing shadow sends queued while VA is slow. One worker keeps
# FIFO enqueue order. Overflow drops only the shadow copy.
ENTRY_V2_SHADOW_QUEUE_CAPACITY=8
# Clean shutdown may drain shadow work for at most this many seconds.
ENTRY_V2_SHADOW_SHUTDOWN_TIMEOUT_SECONDS=5.0
# SQL Server replay lock wait; keep below VA's callback request timeout.
# Authoritative mode refuses startup on any non-MSSQL DATABASE_URL.
ENTRY_V2_APPLOCK_TIMEOUT_MS=1000
# Outbound file cap accepted by VA after adaptive JPEG fitting.
ENTRY_V2_MAX_IMAGE_BYTES=4194304
# Per-source compressed-image guard before crop/downscale. This must not exceed
# CAMERA_EVENT_MAX_BODY_BYTES; multipart overhead makes the body cap effective
# first for a source that approaches this value.
ENTRY_V2_MAX_SOURCE_IMAGE_BYTES=16777216
ENTRY_V2_MAX_IMAGES=4
# Exact outbound envelope; keep equal to VA's decoded-image defaults.
ENTRY_V2_MAX_DECODED_PIXELS=12000000
ENTRY_V2_MAX_IMAGE_DIMENSION=8192
# Independent bomb guard for the larger source image PMS crops/downscales.
ENTRY_V2_MAX_SOURCE_DECODED_PIXELS=30000000
ENTRY_V2_CROP_PADDING_RATIO=0.12
# Optional explicit calibration for cameras whose line is physically one-way.
# Syntax: camera_id:line_id. Without raw direction or this opt-in, V2 rejects
# the crossing instead of synthesizing an inward direction.
ENTRY_V2_ONE_WAY_LINES=

# Existing CAM-03 inward calibration reused by Entry V2 full-frame fallback.
# Contradictory/non-entry line or raw-direction values are rejected.
OCCUPANCY_ENTRANCE_ZONES=1
OCCUPANCY_EXIT_ZONES=2
FORWARD_DIRECTION_FIELD=B-to-A

# ── Camera inventory loaded from the DB `cameras` table ──────────────────────
# At startup the camera inventory (id, ip, username, password, name) is read
# from the shared DB instead of the CAM_XX_* vars above (those are kept as a
# per-field fallback). Passwords are stored Fernet-encrypted; set the SAME
# urlsafe-base64 key the API Gateway uses so they can be decrypted here.
# Leave empty to fall back to the CAM_XX_PASSWORD values.
CAMERAS_ENCRYPTION_KEY=
